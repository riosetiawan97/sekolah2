{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.7.4",
      "excludeFiles": "{theme/**,assets/metronic/**,assets/images/**,assets/plugins/**,assets/ckeditor/**,assets/dist/**,assets/bootstrap/**,assets/jquery-ui/**,assets/font-awesome/**,assets/build/**}"
    }
  },
  "routes": [
    {
      "src": "/install",
      "dest": "/api/install.php"
    },
    {
      "src": "^/(?!assets/|theme/)(.*)$",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/assets/(images|files)/([^/]+)$",
      "dest": "/api/blob.php?p=$1/$2"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
